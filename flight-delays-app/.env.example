# Скопируйте в .env и задайте значения: cp .env.example .env
# Файл .env не должен попадать в git.

# ── Обязательные настройки ──
# Пароль пользователя PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_db_password
# Секрет подписи сессий (не короче 32 символов). Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
# Первый администратор (создаётся при первом запуске, если администраторов ещё нет).
# После входа смените пароль в профиле и удалите FIRST_ADMIN_PASSWORD из этого файла.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME_admin_password_1

# ── Адрес сайта ──
# Локальная проверка по HTTP:  :80
# Публичный сайт по HTTPS:     ваш домен, например flights.example.by (DNS должен указывать на сервер)
SITE_ADDRESS=:80
# true, когда сайт открывается по HTTPS (иначе браузер не сохранит cookie сессии)
COOKIE_SECURE=false
# Допустимые Origin для изменяющих запросов; запросы с того же хоста разрешены всегда
APP_ORIGINS=http://localhost

# ── Необязательные настройки ──
# Число процессов бэкенда
WEB_CONCURRENCY=2
# Ограничение частоты запросов на IP
RATE_LIMIT_DEFAULT=300/minute
# Одновременных формирований отчётов (PDF с графиками ресурсоёмки)
EXPORT_MAX_CONCURRENT=2
# Документация API по адресу /api/docs (false — отключить)
ENABLE_DOCS=true
